FROM docker.io/library/debian:sid-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
	&& apt-get install -y --no-install-recommends \
		build-essential \
		ca-certificates \
		gettext \
		git \
		libcurl4-openssl-dev \
		libevdev-dev \
		libinih-dev \
		libopencv-dev \
		libpam0g-dev \
		libssl-dev \
		meson \
		ninja-build \
		nodejs \
		libyyjson-dev \
		pkg-config \
	&& rm -rf /var/lib/apt/lists/*

LABEL org.opencontainers.image.source="https://codeberg.org/nathawat/howdy-next" \
	  org.opencontainers.image.description="Howdy Next CI build image" \
	  org.opencontainers.image.licenses="MIT"
