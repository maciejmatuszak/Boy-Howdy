FROM docker.io/library/archlinux:latest

RUN pacman -Syu --noconfirm --needed \
		curl \
		gcc \
		gettext \
		git \
		libevdev \
		libinih \
		'meson>=1.11.0' \
		ninja \
		nodejs \
		openssl \
		'opencv>=5.0.0' \
		pam \
		pkgconf \
		qt6-base \
		'yyjson>=0.12.0' \
	&& pacman -Scc --noconfirm

LABEL org.opencontainers.image.source="https://codeberg.org/nathawat/howdy-next" \
	  org.opencontainers.image.description="Howdy Next CI build image"
