# Strict, selective policy.
# Explicit misc/cppcoreguidelines checks prevent future clang-tidy releases
# from silently widening CI policy. System headers stay excluded.

Checks: "
  clang-diagnostic-*,
  clang-analyzer-*,
  bugprone-*,
  modernize-*,
  performance-*,
  readability-*,
  misc-throw-by-value-catch-by-reference,
  misc-static-assert,
  misc-uniqueptr-reset-release,
  misc-header-include-cycle,
  misc-definitions-in-headers,
  cppcoreguidelines-pro-type-member-init,
  cppcoreguidelines-pro-type-cstyle-cast,
  cppcoreguidelines-prefer-member-initializer,
  -readability-magic-numbers,
  -readability-identifier-length,
  -readability-function-cognitive-complexity,
  -readability-non-const-parameter,
  -readability-convert-member-functions-to-static,
  -modernize-use-trailing-return-type,
  -bugprone-easily-swappable-parameters,
  -bugprone-implicit-widening-of-multiplication-result,
  -performance-enum-size,
  -modernize-use-using"

WarningsAsErrors: "
  clang-diagnostic-*,
  clang-analyzer-*,
  bugprone-*,
  modernize-*,
  performance-*,
  readability-*,
  misc-throw-by-value-catch-by-reference,
  misc-static-assert,
  misc-uniqueptr-reset-release,
  misc-header-include-cycle,
  misc-definitions-in-headers,
  cppcoreguidelines-pro-type-member-init,
  cppcoreguidelines-pro-type-cstyle-cast,
  -readability-magic-numbers,
  -readability-identifier-length,
  -readability-function-cognitive-complexity,
  -readability-non-const-parameter,
  -readability-convert-member-functions-to-static,
  -modernize-use-trailing-return-type,
  -bugprone-easily-swappable-parameters,
  -bugprone-implicit-widening-of-multiplication-result,
  -performance-enum-size,
  -modernize-use-using"

HeaderFilterRegex: "(^|.*/)(howdy|pam)/"
ExcludeHeaderFilterRegex: "^/usr/include/"

CheckOptions:
  - key: readability-function-cognitive-complexity.Threshold
    value: "25"
  - key: bugprone-easily-swappable-parameters.MinimumLength
    value: "4"
  - key: bugprone-easily-swappable-parameters.MaximumDistance
    value: "2"

# vim:syntax=yaml
