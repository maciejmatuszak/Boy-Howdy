# Broad, strict clang-tidy policy.
#
# All selected general-purpose checks are enforced as errors except:
#
# - Compiler-owned diagnostics:
#   - clang-diagnostic-*
#   - readability-misleading-indentation
#
# - Repository-wide low-signal style checks:
#   - readability-magic-numbers
#   - readability-identifier-length

InheritParentConfig: false

Checks: >-
  clang-analyzer-*,
  bugprone-*,
  modernize-*,
  performance-*,
  readability-*,
  misc-throw-by-value-catch-by-reference,
  misc-static-assert,
  misc-uniqueptr-reset-release,
  misc-header-include-cycle,
  misc-definitions-in-headers,
  cppcoreguidelines-pro-type-member-init,
  cppcoreguidelines-pro-type-cstyle-cast,
  cppcoreguidelines-prefer-member-initializer,
  -clang-diagnostic-*,
  -readability-misleading-indentation,
  -readability-magic-numbers,
  -readability-identifier-length

WarningsAsErrors: >-
  clang-analyzer-*,
  bugprone-*,
  modernize-*,
  performance-*,
  readability-*,
  misc-throw-by-value-catch-by-reference,
  misc-static-assert,
  misc-uniqueptr-reset-release,
  misc-header-include-cycle,
  misc-definitions-in-headers,
  cppcoreguidelines-pro-type-member-init,
  cppcoreguidelines-pro-type-cstyle-cast,
  cppcoreguidelines-prefer-member-initializer,
  -clang-diagnostic-*,
  -readability-misleading-indentation,
  -readability-magic-numbers,
  -readability-identifier-length

HeaderFilterRegex: '(^|.*/)(howdy|pam)/'
ExcludeHeaderFilterRegex: '(^|.*/)(build[^/]*/|_deps/)|^/usr/(local/)?include/'

SystemHeaders: false
FormatStyle: file
