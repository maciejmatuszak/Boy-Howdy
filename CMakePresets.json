{
	"version": 10,
	"cmakeMinimumRequired": {
		"major": 3,
		"minor": 31,
		"patch": 0
	},
	"configurePresets": [
		{
			"name": "release",
			"displayName": "Release",
			"binaryDir": "${sourceDir}/build/release",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release"
			}
		},
		{
			"name": "debug",
			"displayName": "Debug",
			"binaryDir": "${sourceDir}/build/debug",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug"
			}
		},
		{
			"name": "e2e",
			"displayName": "Privileged E2E",
			"binaryDir": "${sourceDir}/build/e2e",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release",
				"CMAKE_INSTALL_PREFIX": "/opt/howdy-installed-pam-e2e-local",
				"HOWDY_WARNINGS_AS_ERRORS": "ON",
				"HOWDY_ENABLE_PRIVILEGED_TESTS": "ON"
			}
		}
	],
	"buildPresets": [
		{
			"name": "release",
			"configurePreset": "release"
		},
		{
			"name": "debug",
			"configurePreset": "debug"
		},
		{
			"name": "e2e",
			"configurePreset": "e2e",
			"targets": [
				"howdy-installed-e2e-artifacts"
			]
		}
	],
	"testPresets": [
		{
			"name": "release",
			"configurePreset": "release",
			"output": {
				"outputOnFailure": true
			},
			"execution": {
				"jobs": 0
			}
		},
		{
			"name": "debug",
			"configurePreset": "debug",
			"output": {
				"outputOnFailure": true
			},
			"execution": {
				"jobs": 0
			}
		},
		{
			"name": "e2e",
			"configurePreset": "e2e",
			"filter": {
				"include": {
					"label": "privileged"
				}
			},
			"output": {
				"outputOnFailure": true
			},
			"execution": {
				"jobs": 1
			}
		}
	]
}
