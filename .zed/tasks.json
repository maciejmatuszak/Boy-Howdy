// Project tasks configuration. See https://zed.dev/docs/tasks for documentation.
[
	{
		"label": "Build: Meson",
		"command": "meson",
		"args": ["setup", "build"],
		"cwd": "$ZED_WORKTREE_ROOT",
		"use_new_terminal": false,
		"allow_concurrent_runs": false,
		"reveal": "always",
		"hide": "on_success",
		"show_summary": true,
		"show_command": true,
		"save": "all",
	},
	{
		"label": "Build: Ninja",
		"command": "ninja",
		"args": ["-C", "build"],
		"cwd": "$ZED_WORKTREE_ROOT",
		"use_new_terminal": false,
		"allow_concurrent_runs": false,
		"reveal": "always",
		"hide": "on_success",
		"show_summary": true,
		"show_command": true,
		"save": "all",
	},
	{
		"label": "Test: All",
		"command": "meson",
		"args": ["test", "-C", "build", "--print-errorlogs"],
		"cwd": "$ZED_WORKTREE_ROOT",
		"use_new_terminal": false,
		"allow_concurrent_runs": false,
		"reveal": "always",
		"hide": "on_success",
		"show_summary": true,
		"show_command": true,
		"save": "all",
	},
	{
		"label": "Test: $ZED_SELECTED_TEXT",
		"command": "meson",
		"args": ["test", "-C", "build", "$ZED_SELECTED_TEXT", "--print-errorlogs"],
		"cwd": "$ZED_WORKTREE_ROOT",
		"use_new_terminal": false,
		"allow_concurrent_runs": false,
		"reveal": "always",
		"hide": "on_success",
		"show_summary": true,
		"show_command": true,
		"save": "all",
	},
	{
		"label": "Format: C/C++",
		"command": "find howdy pam -type f \\( -name '*.cpp' -o -name '*.hpp' -o -name '*.c' -o -name '*.h' \\) -exec clang-format -i {} +",
		"cwd": "$ZED_WORKTREE_ROOT",
		"use_new_terminal": false,
		"allow_concurrent_runs": false,
		"reveal": "no_focus",
		"hide": "on_success",
		"show_summary": true,
		"show_command": true,
		"save": "all",
	},
	{
		"label": "Clang-Tidy: Diff",
		"command": "git diff -U0 HEAD -- howdy pam | /usr/share/clang/clang-tidy-diff.py -p1 -path build -quiet -hide-progress",
		"cwd": "$ZED_WORKTREE_ROOT",
		"use_new_terminal": false,
		"allow_concurrent_runs": false,
		"reveal": "always",
		"hide": "on_success",
		"show_summary": true,
		"show_command": true,
		"save": "all",
	},
	{
		"label": "Clang-Tidy: Full",
		"command": "run-clang-tidy",
		"args": ["-p", "build", "-quiet"],
		"cwd": "$ZED_WORKTREE_ROOT",
		"use_new_terminal": false,
		"allow_concurrent_runs": false,
		"reveal": "always",
		"hide": "on_success",
		"show_summary": true,
		"show_command": true,
		"save": "all",
	},
]
